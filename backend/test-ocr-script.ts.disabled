import * as fs from 'fs';
import * as path from 'path';
import { OcrService } from './src/ocr/ocr.service';

async function testOCR() {
  console.log('--- OCR REAL TEST START ---');
  try {
    const ocrService = new OcrService();
    const imagePath = path.join(__dirname, 'test-plate.png');
    const imageBuffer = fs.readFileSync(imagePath);

    console.log(`Loaded image from: ${imagePath}`);
    // Test the extraction
    const result = await ocrService.extractMatricule(imageBuffer);
    console.log('\n--- OCR REAL TEST RESULT ---');
    console.log(`Extracted Plate: ${result.matricule}`);
    console.log('Raw Text Output:');
    console.log(result.raw);
  } catch (error) {
    console.error('Error during OCR test:', error);
  }
}

testOCR();
