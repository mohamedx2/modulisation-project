{
    "name": "renault-axis-saas",
    "private": true,
    "scripts": {
        "prepare": "husky",
        "dev": "concurrently \"npm run start:dev -w backend\" \"npm run dev -w frontend\""
    },
    "devDependencies": {
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "concurrently": "^8.2.2",
        "husky": "^9.0.0",
        "lint-staged": "^15.2.0",
        "prettier": "^3.0.0"
    },
    "lint-staged": {
        "apps/frontend/**/*.{js,jsx,ts,tsx}": [
            "npm run lint -w frontend"
        ],
        "apps/backend/src/**/*.ts": [
            "npm run lint -w backend"
        ]
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}