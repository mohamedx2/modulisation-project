{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_count[5m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "Average Response Time",
      "type": "timeseries",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[5m]) / rate(http_request_duration_seconds_count[5m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_count{code=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count[5m])) * 100",
          "legendFormat": "Error %"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "Node.js Heap Memory",
      "type": "timeseries",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "default" },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "Used"
        },
        {
          "expr": "nodejs_heap_size_total_bytes",
          "legendFormat": "Total"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "title": "Application Logs",
      "type": "logs",
      "id": 5,
      "datasource": { "type": "loki", "uid": "default" },
      "targets": [
        {
          "expr": "{app=\"backend\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["nestjs", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NestJS Backend Dashboard",
  "uid": "nestjs-backend",
  "version": 1
}
